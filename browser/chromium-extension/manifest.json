{
  "manifest_version": 3,
  "name": "Alfred Browser Bridge",
  "version": "0.1.0",
  "description": "Lets the local Alfred app observe and operate the installed browser with explicit permissions.",
  "permissions": ["activeTab", "nativeMessaging", "scripting", "storage", "tabs"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [{
    "matches": ["http://*/*", "https://*/*"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }],
  "action": { "default_title": "Alfred Browser Bridge", "default_popup": "popup.html" }
}
